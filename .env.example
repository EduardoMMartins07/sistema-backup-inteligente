# Copie este arquivo para .env e substitua o valor abaixo pela sua chave real.
# Nunca compartilhe nem versione o arquivo .env.
GEMINI_API_KEY=SUA_CHAVE_AQUI

# Opcional: trocar o modelo usado pela classificacao.
GEMINI_MODEL=gemini-2.5-flash

# Opcional: desativar a LLM sem remover a chave.
SMARTBACKUP_LLM_ENABLED=true
