# Copie este arquivo para .env e substitua o valor abaixo pela sua chave real.
# Nunca compartilhe nem versione o arquivo .env.
GEMINI_API_KEY=Sua_Chave_Aqui

# Opcional: trocar o modelo usado pela classificacao.
GEMINI_MODEL=gemini-2.5-flash

# Opcional: desativar a LLM sem remover a chave.
SMARTBACKUP_LLM_ENABLED=true

# Opcional: ativar intervalos reduzidos de backup por prioridade para desenvolvimento local.
BACKUP_DEV_MODE=true

# API central multiempresa e painel web.
SMARTBACKUP_ENV=development
PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000

# ─── Neon (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://neondb_owner:
# Use SQLite local em desenvolvimento ou PostgreSQL em deploy.
DATABASE_URL=sqlite:///config/api.sqlite3
SMARTBACKUP_API_DB_PATH=config/api.sqlite3
SMARTBACKUP_DB_POOL_MIN=0
SMARTBACKUP_DB_POOL_MAX=5
SMARTBACKUP_DB_CONNECT_TIMEOUT=10
SMARTBACKUP_AUTO_MIGRATE=true
SMARTBACKUP_LOG_WEB_TIMING=false
SMARTBACKUP_API_STORAGE_ROOT=api_storage
SMARTBACKUP_API_STORAGE_BACKEND=local
SMARTBACKUP_API_BASE_S3_PREFIX=backups
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=7d
JWT_EXPIRES_MINUTES=10080
SMARTBACKUP_JWT_SECRET=troque-esta-chave-em-producao
SMARTBACKUP_JWT_EXPIRE_MINUTES=1440

# Amazon S3 usado pela API online e URLs pre-assinadas.
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=sa-east-1
AWS_S3_BUCKET=change_me
AWS_ENDPOINT_URL=
PRESIGNED_URL_EXPIRES_SECONDS=900

# CORS e upload.
CORS_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_SIZE_MB=500

# Seed opcional de demonstracao. Nao use senhas fixas em producao.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_PASSWORD=
