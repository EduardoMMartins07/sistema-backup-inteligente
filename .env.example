# Copie este arquivo para .env e substitua o valor abaixo pela sua chave real.
# Nunca compartilhe nem versione o arquivo .env.
GEMINI_API_KEY=Sua_Chave_Aqui

# Opcional: trocar o modelo usado pela classificacao.
GEMINI_MODEL=gemini-2.5-flash

# Opcional: desativar a LLM sem remover a chave.
SMARTBACKUP_LLM_ENABLED=true

# Opcional: ativar intervalos reduzidos de backup por prioridade para desenvolvimento local.
BACKUP_DEV_MODE=true

# API central multiempresa e painel web.
SMARTBACKUP_API_DB_PATH=config/api.sqlite3
SMARTBACKUP_API_STORAGE_ROOT=api_storage
SMARTBACKUP_API_STORAGE_BACKEND=local
SMARTBACKUP_API_BASE_S3_PREFIX=backups
SMARTBACKUP_JWT_SECRET=troque-esta-chave-em-producao
SMARTBACKUP_JWT_EXPIRE_MINUTES=1440
